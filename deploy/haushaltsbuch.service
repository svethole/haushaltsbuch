[Unit]
Description=Haushaltsbuch (Web-App)
After=network.target

[Service]
Type=simple
# Eigener, automatisch angelegter Systembenutzer ohne Anmeldung
DynamicUser=yes
# Datenbank liegt in /var/lib/haushaltsbuch (wird automatisch angelegt)
StateDirectory=haushaltsbuch
WorkingDirectory=/var/www/haushaltsbuch
ExecStart=/usr/bin/python3 /var/www/haushaltsbuch/server.py --host 127.0.0.1 --port 8085 --db /var/lib/haushaltsbuch/haushaltsbuch.db
Restart=on-failure
RestartSec=3

# Absicherung
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
