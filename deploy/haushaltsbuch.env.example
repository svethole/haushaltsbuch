# Vorlage für /etc/haushaltsbuch.env – E-Mail-Versand für Abo-Erinnerungen
# Kopieren:  sudo cp deploy/haushaltsbuch.env.example /etc/haushaltsbuch.env
# Schützen:  sudo chmod 600 /etc/haushaltsbuch.env
# Danach:    sudo systemctl restart haushaltsbuch

# Beispiel Fastmail: Postausgangsserver smtp.fastmail.com, Port 465 (SSL).
# Als Passwort in den Fastmail-Einstellungen ein eigenes App-Passwort (mit Zugriff auf SMTP) anlegen,
# nicht das normale Login-Passwort.
HB_SMTP_HOST=smtp.fastmail.com
HB_SMTP_PORT=465
HB_SMTP_USER=deine-adresse@fastmail.com
HB_SMTP_PASSWORD=app-passwort-hier-eintragen
HB_SMTP_FROM=Haushaltsbuch <deine-adresse@fastmail.com>

# Adresse der Seite – für den Link in der E-Mail
HB_BASE_URL=https://haushaltsbuch.svetho.net
